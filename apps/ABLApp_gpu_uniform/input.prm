DomainSetup
{
    domainSize    <150, 150, 75>;
    cellsPerBlock <150, 150, 75>;

    loadSnapshot    0;
    storeSnapshot   0;
    snapshotFrequency 250;
    snapshotBaseFolder snapshot;
    snapshotConfigFile TurbineSnapshot.config;
    snapshotBlockforestFile TurbineSnapshot.forest;
    snapshotPdfFile TurbineSnapshot.pdf;
    snapshotForceFile TurbineSnapshot.force;
    snapshotMeanVelFile TurbineSnapshot.mean;
    snapshotSOPFile TurbineSnapshot.sop;
}

Parameters
{
    timesteps          2400000;

    length_SI             20;
    length_LU              150;

    velocity_SI            185;
    velocity_LU            1;

    viscosity_SI           0.00001776;
    density_SI             1.225;

    remainingTimeLoggerFrequency 60; // in seconds

    roughnessLengthRatio 0.0000277778;// 0.000027536
    referenceHeight_LU   81;
    samplingHeight_LU    12;

    compressible           true; // Read by LBMGeneration.py at code-generation time (rebuild required after changes)

    driverType          pressureGradient; //none, pressureGradient, dynamicPressureGradient, coriolisForce
    coriolisFrequency   0.0001; // given in s^-1; Only applicable if drivertype is coriolisForce
    geostrophicWind     <0, 0, 0>; // given in m*s^-1, the third component should ALWAYS be 0; Only applicable if drivertype is coriolisForce
    windDirectionDegrees 0; // Only applicable if drivertype is pressureGradient
    windDirectionChangeRateTable "windDirectionChange.wd"; // Only applicable if drivertype is dynamicPressureGradient

    cudaEnabledMPI false;
}

Initialisation {
    type asmuth; // logLaw; // uniform; //asmuth;
    initialVelocity <0.122574545, 0, 0>; // Used to calculate friction velocity
}

// Reason for edit start: switch the example prm from the Phase 2 stationary sphere to a Phase 3 kinematic sphere test while keeping the static urban obstacle block unchanged.
MesaPD
{
    enabled true;
    subcycles 1;
}

PSM
{
    enabled true;
    phase1ScaffoldOnly false; // Keep this false for the real Phase 3 runtime path
}

MovingBody
{
    enabled true;
    mode kinematic; // Phase 3 currently supports only a kinematic sphere
    representation sphere; // Phase 3 currently supports only sphere
    radius 8;
    initialPosition <800, 180, 50>;
    initialVelocity <0, 0, 0>; // Used only when no trajectory keyframes are provided
}

Trajectory
{
    type piecewise_linear; // Phase 3 interpolates the sphere center between these keyframes

    point
    {
        step 100000;
        center <300, 180, 60>;
    }
    point
    {
        step 120000;
        center <300, 180, 55>;
    }
    point
    {
        step 140000;
        center <300, 180, 50>;
    }
    point
    {
        step 160000;
        center <300, 180, 45>;
    }
    point
    {
        step 180000;
        center <300, 180, 40>;
    }
    point
    {
        step 200000;
        center <300, 180, 40>;
    }
}
// Reason for edit end: switch the example prm from the Phase 2 stationary sphere to a Phase 3 kinematic sphere test while keeping the static urban obstacle block unchanged.

Boundaries
{
    setup                   FreeSlip;

    inflowType              logLawInflow; // periodic, shiftedPeriodic, logLawInflow, uniformInflow
    outflowType             outflow;

    inflowVelocity          <0.05, 0, 0>; // Only applicable if inflowType is set uniformInflow
    outflowPressure         1.0; //not used in this application

        wallType                NoSlip; // ignored for FreeSlip setup, kept for compatibility
        topBoundaryType         slip; // symmetry/slip/outflow
        topDampingHeight        0; // cells below the top boundary; 0 disables damping
        topDampingMaxStrength   0.02; // LU relaxation strength at the top cell
        topDampingHorizontal    true; // relax u,v toward the running mean field
        topDampingVertical      true; // relax w toward zero

    numberElements 0;
    elementDistance 0;
    elementLength 0;

Body
{
    shape box;
    min   <374, 165, 0>;
    max   <614, 195, 29>;
    flag WFB Flag;
}
}

StabilityChecker
{
    checkFrequency 100;
    streamOutput   false;
    vtkOutput      true;
}

Output
{
    welfordInterval 1000;
    VTK
    {
        writeFrequency 5000;
        startTimestep  27000;
        ghostLayers    0;
        samplingDx 1;
        samplingDy 1;
        samplingDz 1;

        baseFolder           vtk_out_Juergen Rauleder_paper_reduced_box_960x360x192_Test_9_obstacle_WFB;
        executionFolder      simulation_step;

    inclusion_filters
    {
        DynamicAABB
        {
            trajectoryType piecewise_linear;
            limitMode clamp;
            center0 <445, 180, 40>;
            size0 <350, 140, 80>;

            point
            {
                step 2700;
                center <550, 180, 40>;
            }

            point
            {
                step 3050;
                center <650, 180, 40>;
            }

            point
            {
                step 3400;
                center <750, 180, 40>;
            }

            point
            {
                step 3750;
                center <445, 180, 40>;
            }
        }
    }

        fields {
            Density;
            EddyViscosity;
            Force;
            MeanEddyViscosity;
            MeanStrainRate;
            MeanVelocityOutput;
            Omega;
            StrainRate;
            SumOfCubes;
            SumOfSquares;
            Velocity;
        }

        writeFlagField 1;
        writeDomainDecomposition;
    }

        LineOutput
    {
        Line
        {
            start      <800, 180, 0>;
            end        <800, 180, 50>;
            resolution 3;
        }

        Fields
        {
            Velocity;
        }

        outputFrequency  5;
        startingTimeStep 26950;
    }
}
