DomainSetup
{
    domainSize    <260, 200, 30>;
    cellsPerBlock <260, 200, 30>;

    loadSnapshot    0;
    storeSnapshot   0;
    snapshotFrequency 250;
    snapshotBaseFolder snapshot;
    snapshotConfigFile TurbineSnapshot.config;
    snapshotBlockforestFile TurbineSnapshot.forest;
    snapshotPdfFile TurbineSnapshot.pdf;
    snapshotForceFile TurbineSnapshot.force;
    snapshotMeanVelFile TurbineSnapshot.mean;
    snapshotSOPFile TurbineSnapshot.sop;
}

Parameters
{
    timesteps          2400000;

    length_SI             1300;
    length_LU              260;

    velocity_SI            10;
    velocity_LU            1;

    viscosity_SI           0.00001776;
    density_SI             1.225;

    remainingTimeLoggerFrequency 5; // in seconds

    roughnessLengthRatio 0.0000277778;
    referenceHeight_LU   81;
    samplingHeight_LU    12;

    driverType          pressureGradient; //none, pressureGradient, dynamicPressureGradient, coriolisForce
    coriolisFrequency   0.0001; // given in s^-1; Only applicable if drivertype is coriolisForce
    geostrophicWind     <10, 0, 0>; // given in m*s^-1, the third component should ALWAYS be 0; Only applicable if drivertype is coriolisForce
    windDirectionDegrees 0; // Only applicable if drivertype is pressureGradient
    windDirectionChangeRateTable "windDirectionChange.wd"; // Only applicable if drivertype is dynamicPressureGradient

    cudaEnabledMPI false;
}

Initialisation {
    type asmuth; // logLaw; // uniform; //asmuth;
    initialVelocity <0.05, 0, 0>; //Used to calculate friction velocity
}

Boundaries
{
    setup                   Open;

    inflowType              logLawInflow; // periodic, shiftedPeriodic, logLawInflow, uniformInflow
    outflowType             outFlow;

    inflowVelocity          <0.05, 0, 0>; // Only applicable if inflowType is set uniformInflow
    outflowPressure         1.0; //not used in this application

    wallType                WFB;

    numberElements 0;
    elementDistance 0;
    elementLength 0;

// Generated by scene-to-STL-geometry.py
// Mesh vertices are written in lattice units (LU) inside the referenced STL files.
// Placement is baked into the STL vertices, so each block uses scale <1,1,1> and offset <0,0,0>.

MeshObject
{
    file /home/yanlab/walberla/python-airport/scene-to-geometry/walberla_meshes/scene_merged.stl;
    flag NoSlip;
    scale <1.0, 1.0, 1.0>;
    offset <0.0, 0.0, 0.0>;
    binary true;
    // merged objects: 12, triangles: 760
}
}

StabilityChecker
{
    checkFrequency 1000;
    streamOutput   false;
    vtkOutput      true;
}

Output
{
    welfordInterval 800000;
    VTK
    {
        writeFrequency 2400000;
        startTimestep  2300000;
        ghostLayers    0;

        baseFolder           vtk_out_Test_2_with_STL_Airport;
        executionFolder      simulation_step;

        fields {
            Density;
            EddyViscosity;
            Force;
            MeanEddyViscosity;
            MeanStrainRate;
            MeanVelocityOutput;
            Omega;
            StrainRate;
            SumOfCubes;
            SumOfSquares;
            Velocity;
        }

        writeFlagField 4;
        writeDomainDecomposition;
    }
}
