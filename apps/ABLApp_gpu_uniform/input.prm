DomainSetup
{
    domainSize    <960, 360, 192>;
    cellsPerBlock <480, 360, 192>;

    loadSnapshot    0;
    storeSnapshot   0;
    snapshotFrequency 250;
    snapshotBaseFolder snapshot;
    snapshotConfigFile TurbineSnapshot.config;
    snapshotBlockforestFile TurbineSnapshot.forest;
    snapshotPdfFile TurbineSnapshot.pdf;
    snapshotForceFile TurbineSnapshot.force;
    snapshotMeanVelFile TurbineSnapshot.mean;
    snapshotSOPFile TurbineSnapshot.sop;
}

Parameters
{
    timesteps          20000;

    length_SI             1.54;
    length_LU             240;

    velocity_SI           21.2;
    velocity_LU            0.122574545;

    viscosity_SI           0.00001776;
    density_SI             1.225;

    remainingTimeLoggerFrequency 60; // in seconds

    roughnessLengthRatio 0.02688172;
    referenceHeight_LU   29;
    samplingHeight_LU    6;

    compressible           true; // Read by LBMGeneration.py at code-generation time (rebuild required after changes)

    driverType          none; //none, pressureGradient, dynamicPressureGradient, coriolisForce
    coriolisFrequency   0.0001; // given in s^-1; Only applicable if drivertype is coriolisForce
    geostrophicWind     <0, 0, 0>; // given in m*s^-1, the third component should ALWAYS be 0; Only applicable if drivertype is coriolisForce
    windDirectionDegrees 0; // Only applicable if drivertype is pressureGradient
    windDirectionChangeRateTable "windDirectionChange.wd"; // Only applicable if drivertype is dynamicPressureGradient

    cudaEnabledMPI false;
}

Initialisation {
    type asmuth; // logLaw; // uniform; //asmuth;
    initialVelocity <0.122574545, 0, 0>; // Used to calculate friction velocity
}

// Reason for edit start: Phase 4e is being switched from the hub-plus-one-blade prototype to a symmetric hub-plus-three-blade rotor so the current assembly-centering logic has a better-behaved rotor-only test before the later rotation-center code fix.
MesaPD
{
    enabled true;
    subcycles 1;
}

PSM
{
    enabled true;
    phase1ScaffoldOnly false; // Keep this false for the real Phase 4 runtime path
}

MovingBody
{
    enabled true;
    mode kinematic; // Phase 4 still uses prescribed kinematics rather than force-driven motion
    representation convex_polyhedron; // convex_polyhedron, box, sphere ---- Phase 4e can now use one or more convex mesh pieces under one rigid-body motion
    radius 8; // Used only when representation = sphere
    boxEdgeLength <30, 90, 90>; // Phase 4e hub-plus-three-blade envelope: keeps the rotor disk compact enough to remain safely inside the current domain
    piece
    {
        meshFile "/home/yanpersonalresearch/walberla/turbine-core/apps/ABLApp_gpu_uniform/phase4e_rotor_assets/blade_hub_phase4e_rotor_aligned.stl"; // Phase 4e rotor-only piece 1: aligned hub in the shared local rotor frame
        offset <0, 0, 0>;
    }
    piece
    {
        meshFile "/home/yanpersonalresearch/walberla/turbine-core/apps/ABLApp_gpu_uniform/phase4e_rotor_assets/matt_bladerev5_phase4e_rotor3_blade_a.stl"; // Phase 4e rotor-only piece 2: blade A in the shared local rotor frame
        offset <0, 0, 0>;
    }
    piece
    {
        meshFile "/home/yanpersonalresearch/walberla/turbine-core/apps/ABLApp_gpu_uniform/phase4e_rotor_assets/matt_bladerev5_phase4e_rotor3_blade_b.stl"; // Phase 4e rotor-only piece 3: blade B pre-rotated by 120 degrees around the rotor axis
        offset <0, 0, 0>;
    }
    piece
    {
        meshFile "/home/yanpersonalresearch/walberla/turbine-core/apps/ABLApp_gpu_uniform/phase4e_rotor_assets/matt_bladerev5_phase4e_rotor3_blade_c.stl"; // Phase 4e rotor-only piece 4: blade C pre-rotated by 240 degrees around the rotor axis
        offset <0, 0, 0>;
    }
    initialPosition <300, 180, 75>; // Fixed-center case: lifted slightly so the convex-assembly interaction radius remains inside the domain in z
    initialVelocity <0, 0, 0>; // Fixed-center case: no translational motion
    initialRotation <0, 0, 0>; // Rotation-vector units: rad; the aligned STL assets already place the rotor axis along X
    angularVelocity <0.0005, 0, 0>; // Fixed-center case: spin the rotor about its local X axis
}

Trajectory
{
    type piecewise_linear; // With one keyframe the moving body stays fixed at the prescribed center

    point
    {
        step 0;
        center <300, 180, 75>;
    }
}
// Reason for edit end: Phase 4e is being switched from the hub-plus-one-blade prototype to a symmetric hub-plus-three-blade rotor so the current assembly-centering logic has a better-behaved rotor-only test before the later rotation-center code fix.

Boundaries
{
    setup                   FreeSlip;

    inflowType              logLawInflow; // periodic, shiftedPeriodic, logLawInflow, uniformInflow
    outflowType             outflow;

    inflowVelocity          <0.05, 0, 0>; // Only applicable if inflowType is set uniformInflow
    outflowPressure         1.0; //not used in this application

        wallType                NoSlip; // ignored for FreeSlip setup, kept for compatibility
        topBoundaryType         slip; // symmetry/slip/outflow
        topDampingHeight        0; // cells below the top boundary; 0 disables damping
        topDampingMaxStrength   0.02; // LU relaxation strength at the top cell
        topDampingHorizontal    true; // relax u,v toward the running mean field
        topDampingVertical      true; // relax w toward zero

    numberElements 0;
    elementDistance 0;
    elementLength 0;

}

StabilityChecker
{
    checkFrequency 1000;
    streamOutput   false;
    vtkOutput      true;
}

Output
{
    welfordInterval 1000;
    VTK
    {
        writeFrequency 500;
        startTimestep  10000;
        ghostLayers    0;
        samplingDx 1;
        samplingDy 1;
        samplingDz 1;

        
        // Reason for edit start: Phase 4e hub-plus-three-blade runs need their own output folder so they stay separate from both the one-piece hull and the earlier one-blade rotor experiments.
        baseFolder           vtk_out_Juergen_Rauleder_paper_ABL_and_MesaPD_phase_4e_rotor_only_hub_plus_3_blades;
        // Reason for edit end: Phase 4e hub-plus-three-blade runs need their own output folder so they stay separate from both the one-piece hull and the earlier one-blade rotor experiments.
        executionFolder      simulation_step;
inclusion_filters
    {
        DynamicAABB
        {
            trajectoryType piecewise_linear;
            limitMode clamp;
            center0 <300, 180, 75>;
            size0 <200, 140, 140>;

        point
        {
            step 0;
            center <300, 180, 75>;
        }

        point
        {
            step 20000;
            center <300, 180, 75>;
        }
        }
    }

        fields {
            Density;
            EddyViscosity;
            Force;
            MeanEddyViscosity;
            MeanStrainRate;
            MeanVelocityOutput;
            Omega;
            StrainRate;
            SumOfCubes;
            SumOfSquares;
            Velocity;
        }

        writeFlagField 1;
        writeDomainDecomposition;
    }

        LineOutput
    {
        Line
        {
            start      <800, 180, 0>;
            end        <800, 180, 50>;
            resolution 3;
        }

        Fields
        {
            Velocity;
        }

        outputFrequency  5;
        startingTimeStep 10000;
    }
}
